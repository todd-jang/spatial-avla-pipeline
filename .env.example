# ─────────────────────────────────────────────────────────────────────────────
# spatial-avla-pipeline  /  .env.example
# 이 파일을 복사하여 .env 로 사용하세요.
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── 실행 모드 ──────────────────────────────────────────────────────────────────
# "cli"  : python main.py  (단일 프레임 smoke test)
# "ui"   : python run_gradio.py  (Gradio 스트리밍 UI)
POC_RUN_MODE=cli

# ── 파이프라인 패스 ──────────────────────────────────────────────────────────
# UI 경로: graph_ui (fast/no validator)
# CLI 경로: graph   (with pre/post JSON-Schema validator)
PIPELINE_MODE=graph_ui          # graph | graph_ui

# ── 모델 / 캐시 경로 ──────────────────────────────────────────────────────────
WAVLM_MODEL_NAME=microsoft/wavlm-base-plus
WAVLM_EMB_CACHE_DIR=cache/emb
WAVLM_EMB_PATH=cache/emb/wavlm.pt

# ── 원시 데이터 경로 ──────────────────────────────────────────────────────────
RAW_VIDEO_DIR=raw_videos
EXPORTS_DIR=exports
GOLDEN_DIR=golden/fixtures

# ── Gradio 서버 ───────────────────────────────────────────────────────────────
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=true               # Gradio public URL 생성 여부 (true | false)

# ── 디바이스 ──────────────────────────────────────────────────────────────────
TORCH_DEVICE=auto               # auto | cpu | cuda | mps

# ── 히스테리시스 파라미터 (baseline 기본값) ────────────────────────────────────
HYSTERESIS_MIN_HOLD_FRAMES=35
P_SIREN_THRESHOLD=0.80
DOA_CHANGE_RATE_THRESHOLD=15.0
VISION_ANOMALY_MA_THRESHOLD=0.75

# ── 계약(Contract) 스키마 경로 ────────────────────────────────────────────────
CONTRACT_SCHEMA_PATH=contracts/frame_audio_packet_v1.0.json

# ── 로그 ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
